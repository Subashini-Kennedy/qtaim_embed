{
  "optim": {
    "precision": "bf16-mixed",
    "num_devices": 4,
    "num_nodes": 1,
    "accumulate_grad_batches": 1,
    "strategy": "ddp_find_unused_parameters_true",
    "gradient_clip_val": 10.0,
    "train_batch_size": 160,
    "val_batch_size": 256,
    "test_batch_size": 256,
    "num_workers": 0,
    "pin_memory": false,
    "persistent_workers": false,
    "check_val_every_n_epoch": 10,
    "num_sanity_val_steps": 0,
    "log_every_n_steps": 500
  },
  "dataset": {
    "train_dataset_loc": "/lustre/fsn1/projects/rech/ihj/urb54jd/qtaim_embed_private/data_suba/train_qm9_qtaim_1205_labelled_corrected_43k.pkl",
    "test_dataset_loc":  "/lustre/fsn1/projects/rech/ihj/urb54jd/qtaim_embed_private/data_suba/test_qm9_qtaim_1205_labelled_corrected_43k.pkl",

    "train_lmdb": "/lustre/fsn1/projects/rech/ihj/urb54jd/qtaim_embed_private/data_suba/qm9_lmdb_multi_43k/train",
    "val_lmdb":   "/lustre/fsn1/projects/rech/ihj/urb54jd/qtaim_embed_private/data_suba/qm9_lmdb_multi_43k/test",
    "test_lmdb":  "/lustre/fsn1/projects/rech/ihj/urb54jd/qtaim_embed_private/data_suba/qm9_lmdb_multi_43k/test",

    "log_save_dir": "/lustre/fsn1/projects/rech/ihj/urb54jd/qtaim_embed_private/logs_suba/lmdb/",

    "verbose": false,
    "debug": false,
    "num_workers": 0,
    "train_batch_size": 160,
    "val_batch_size": 256,
    "test_batch_size": 256,
    "pin_memory": false,
    "persistent_workers": false,

    "allowed_ring_size": [3,4,5,6],
    "allowed_charges": null,
    "allowed_spins": null,
    "self_loop": true,
    "bond_key": "bonds",
    "map_key": "extra_feat_bond_indices_qtaim",
    "per_atom": false,

    "target_list": ["homo","lumo","gap"],
    "element_set": [],
    "val_prop": 0.1,
    "test_prop": 0.1,
    "seed": 42,

    "extra_dataset_info": null,
    "log_scale_features": false,
    "log_scale_targets": false,
    "standard_scale_features": true,
    "standard_scale_targets": true,

    "extra_keys": {
      "atom":  ["extra_feat_atom_Hamiltonian_K"],
      "bond":  ["extra_feat_bond_Lagrangian_K", "extra_feat_bond_Hamiltonian_K"],
      "global": ["homo","lumo","gap"]
    }
  },
  "model": {
    "atom_feature_size": 13,
    "bond_feature_size": 8,
    "global_feature_size": 3,

    "compile": false,
    "compiled": false,
    "conv_fn": "ResidualBlock",
    "initializer": "kaiming",

    "target_dict": { "global": ["homo","lumo","gap"] },
    "ntasks": 3,

    "dropout": 0.2,
    "batch_norm_tf": true,
    "activation": "ReLU",
    "bias": true,
    "norm": "both",
    "aggregate": "sum",
    "n_conv_layers": 6,

    "lr": 0.001,
    "weight_decay": 5e-05,
    "lr_plateau_patience": 10,
    "lr_scale_factor": 0.5,
    "scheduler_name": "reduce_on_plateau",
    "loss_fn": "mse",

    "resid_n_graph_convs": 3,
    "embedding_size": 100,
    "fc_layer_size": [512,512,512],
    "shape_fc": "flat",
    "fc_dropout": 0.1,
    "fc_batch_norm": true,
    "n_fc_layers": 3,

    "global_pooling_fn": "GlobalAttentionPoolingThenCat",
    "ntypes_pool": ["atom","bond","global"],
    "ntypes_pool_direct_cat": ["global"],

    "lstm_iters": 15,
    "lstm_layers": 2,
    "num_heads": 2,
    "feat_drop": 0.1,
    "attn_drop": 0.1,
    "residual": true,

    "num_heads_gat": 2,
    "dropout_feat_gat": 0.1,
    "dropout_attn_gat": 0.1,
    "hidden_size_gat": 50,
    "hidden_size": 50,
    "residual_gat": true,

    "classifier": false,
    "batch_norm": true,
    "pooling_ntypes": ["atom","bond","global"],
    "pooling_ntypes_direct": ["global"],

    "fc_hidden_size_1": 1024,
    "fc_num_layers": 2,
    "restore": false,
    "max_epochs": 600,
    "extra_stop_patience": 50
  },
  "output_dir": "/lustre/fsn1/projects/rech/ihj/urb54jd/qtaim_embed_private/logs_suba/lmdb/",
  "checkpoint_dir": "/lustre/fsn1/projects/rech/ihj/urb54jd/qtaim_embed_private/checkpoints_suba/lmdb/"
}